  "work_dir": "work",
  "amf_options": {
    "ending_schemes": ["Tradition","SingleMass"],
    "max_recursion_depth": 20,
    "blackbox": {
      "ibp_rank": 1,
      "ibp_dot": 0,
      "integral_order": 5,
      "n_thread": 4,
      "run_firefly": true,
      "auto_firefly": true,
      "numeric_values": {"s": "-1", "t": "-1/3", "msq": "1"}
    }
  }
