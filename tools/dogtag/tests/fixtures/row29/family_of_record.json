      "k1^2 - msq",
      "k2^2 - msq",
      "(l - k1 - k2)^2 - msq",
      "(l - k1)^2",
      "(l - k2)^2",
      "(k1 + p1)^2",
      "(k1 + p2)^2",
      "(k1 + p3)^2",
      "(k2 + p1)^2",
      "(k2 + p2)^2",
      "(k2 + p3)^2"
